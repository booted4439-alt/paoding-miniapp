<!-- 自定义底部标签栏 -->
<view class="tab-bar safe-bottom">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
