/* 庖丁法律服务 - 全局样式 */

/* 主题色 */
page {
  --primary: #4d6bfe;
  --primary-light: #7c93ff;
  --primary-bg: #e8f0f8;
  --success: #07c160;
  --warning: #faad14;
  --danger: #ee0a24;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-hint: #999999;
  --border-color: #e5e5e5;
  --bg-color: #f5f7fa;
  --card-bg: #ffffff;

  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-color);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 卡片容器 */
.card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 主按钮 */
.btn-primary {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4d6bfe, #7c93ff);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  background: #b0c4de;
  color: #ffffff;
}

/* 次级按钮 */
.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: var(--primary);
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 2rpx solid var(--primary);
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.btn-secondary::after {
  border: none;
}

/* 表单输入 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: var(--primary);
  background: #ffffff;
}

/* 带验证码的输入行 */
.input-row {
  display: flex;
  gap: 20rpx;
}

.input-row .input-field {
  flex: 1;
}

.input-row .code-btn {
  flex-shrink: 0;
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--primary);
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.input-row .code-btn.disabled {
  background: #b0c4de;
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  padding: 30rpx 30rpx 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-state text {
  font-size: 28rpx;
  color: var(--text-hint);
  margin-top: 20rpx;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 0 30rpx;
}

/* 状态标签 */
.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-pending { background: #fff7e6; color: #d48806; }
.status-active { background: #e6f7ff; color: #1890ff; }
.status-closed { background: #f5f5f5; color: #999; }

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
