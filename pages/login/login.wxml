<!-- 登录 -->
<view class="login-container">
  <view class="login-header">
    <text class="login-title">欢迎登录</text>
    <text class="login-subtitle">演算法律</text>
  </view>

  <!-- 微信登录（默认显示） -->
  <block wx:if="{{!showBindPhone}}">
    <view class="agreement-checkbox" bindtap="toggleAgreeWechat">
      <checkbox checked="{{agreeWechat}}" color="#4d6bfe" />
      <text class="agree-label">我已阅读并同意</text>
      <text class="link" catchtap="openUrl" data-url="https://calculuslaw.com/terms">《用户协议》</text>
      <text>和</text>
      <text class="link" catchtap="openUrl" data-url="https://calculuslaw.com/privacy">《隐私政策》</text>
    </view>
    <view class="wx-login">
      <button
        class="wx-login-btn"
        style="width: 50%;"
        bindtap="wechatLogin"
      >
        <text>微信一键登录</text>
      </button>
    </view>

    <view class="divider-row">
      <view class="divider-line"></view>
      <text class="divider-text">或</text>
      <view class="divider-line"></view>
    </view>

    <!-- 手机号登录 -->
    <view class="login-form">
      <view class="input-group">
        <input
          class="input-field"
          type="text"
          placeholder="请输入手机号"
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="input-group">
        <input
          class="input-field"
          type="password"
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
      </view>

      <button
        class="btn-primary"
        bindtap="submitLogin"
        disabled="{{submitting}}"
      >登录</button>

      <view class="register-link">
        <text>还没有账号？</text>
        <text class="link" bindtap="goRegister">立即注册</text>
      </view>
    </view>
  </block>

  <!-- 微信首次登录 → 绑定手机号 -->
  <block wx:if="{{showBindPhone}}">
    <view class="bind-phone-container">
      <text class="bind-phone-title">请绑定手机号并设置密码</text>
      <text class="bind-phone-desc">绑定后可使用更多服务，请设置登录密码（用于网页端登录），邮箱选填</text>

      <view class="login-form">
        <!-- 手机号 -->
        <view class="input-group">
          <input
            class="input-field"
            type="text"
            placeholder="请输入手机号"
            maxlength="11"
            value="{{bindPhoneNum}}"
            bindinput="onBindPhoneInput"
          />
        </view>

        <!-- 密码 -->
        <view class="input-group">
          <input
            class="input-field"
            type="password"
            placeholder="请输入密码（至少6位，只能包含字母和数字）"
            value="{{bindPassword}}"
            bindinput="onBindPasswordInput"
          />
        </view>

        <!-- 确认密码 -->
        <view class="input-group">
          <input
            class="input-field"
            type="password"
            placeholder="请确认密码"
            value="{{bindConfirmPassword}}"
            bindinput="onBindConfirmPasswordInput"
          />
        </view>

        <!-- 邮箱（选填） -->
        <view class="input-group">
          <input
            class="input-field"
            type="text"
            placeholder="邮箱（选填，律师回复时可收到通知）"
            value="{{bindEmail}}"
            bindinput="onBindEmailInput"
          />
        </view>

        <view class="agreement-checkbox" style="margin-bottom: 30rpx;" bindtap="toggleAgreeBind">
          <checkbox checked="{{agreeBind}}" color="#4d6bfe" />
          <text class="agree-label">我已阅读并同意</text>
          <text class="link" catchtap="openUrl" data-url="https://calculuslaw.com/terms">《用户协议》</text>
          <text>和</text>
          <text class="link" catchtap="openUrl" data-url="https://calculuslaw.com/privacy">《隐私政策》</text>
        </view>
        <button
          class="btn-primary"
          bindtap="submitBindPhone"
          disabled="{{submitting}}"
        >绑定</button>
      </view>
    </view>
  </block>

  <!-- 手机号已注册 → 输入原密码合并 -->
  <view wx:if="{{mergeModalShow}}" class="merge-mask" catchtap="cancelMerge" catchtouchmove="noop">
    <view class="merge-dialog" catchtap="noop">
      <text class="merge-title">该手机号已注册</text>
      <input
        class="input-field merge-input"
        type="password"
        placeholder="请输入该账户原密码"
        value="{{mergePwd}}"
        focus="{{mergeModalShow}}"
        bindinput="onMergePwdInput"
        confirm-type="done"
      />
      <view class="merge-actions">
        <button class="merge-btn merge-btn-cancel" bindtap="cancelMerge">取消</button>
        <button class="merge-btn merge-btn-ok" bindtap="confirmMerge">合并登录</button>
      </view>
    </view>
  </view>
</view>
