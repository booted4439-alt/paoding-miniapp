/* 登录页 */
.login-container {
  min-height: 100vh;
  background: #ffffff;
  padding: 80rpx 50rpx 40rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.login-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 12rpx;
}

/* 微信登录 */
.wx-login {
  margin-bottom: 40rpx;
}

.wx-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.wx-login-btn:active {
  opacity: 0.85;
}

.wx-icon {
  margin-right: 12rpx;
}

/* 分割线 */
.divider-row {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e5e5e5;
}

.divider-text {
  font-size: 24rpx;
  color: #ccc;
  padding: 0 20rpx;
}

/* 表单 */
.login-form .input-group {
  margin-bottom: 30rpx;
}

.switch-mode {
  text-align: right;
  font-size: 26rpx;
  color: #7c93ff;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.register-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.register-link .link {
  color: #7c93ff;
  margin-left: 4rpx;
}

/* 绑定手机号 */
.bind-phone-container {
  text-align: center;
  padding-top: 40rpx;
}

.bind-phone-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.bind-phone-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 50rpx;
}

.bind-skip {
  margin-top: 50rpx;
  font-size: 26rpx;
  color: #bbb;
  padding: 20rpx;
}

.bind-skip:active {
  opacity: 0.6;
}

/* 协议 */
/* 协议复选框 */
.agreement-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
  line-height: 1.6;
  flex-wrap: wrap;
}

.agreement-checkbox checkbox {
  transform: scale(0.7);
  margin-right: 4rpx;
}

.agreement-checkbox .agree-label {
  margin-right: 4rpx;
}

.agreement-checkbox .link {
  color: #7c93ff;
  display: inline;
}

.agreement-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.agreement-text .link {
  color: #7c93ff;
  display: inline;
}

/* 合并账户确认弹层 */
.merge-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.merge-dialog {
  width: 620rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 44rpx 40rpx 36rpx;
  box-sizing: border-box;
}

.merge-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.merge-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.merge-input {
  margin-top: 28rpx;
}

.merge-actions {
  display: flex;
  margin-top: 40rpx;
}

.merge-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  border-radius: 42rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.merge-btn::after {
  border: none;
}

.merge-btn-cancel {
  background: #f2f3f5;
  color: #666666;
  margin-right: 20rpx;
}

.merge-btn-ok {
  background: #4d6bfe;
  color: #ffffff;
}
