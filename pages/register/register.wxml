<!-- 注册 -->
<view class="register-container">
  <view class="register-header">
    <text class="register-title">创建账号</text>
    <text class="register-subtitle">注册庖丁法律服务账号</text>
  </view>

  <view class="register-form">
    <view class="input-group">
      <input
        class="input-field"
        type="text"
        placeholder="请输入用户名"
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="input-group">
      <input
        class="input-field"
        type="text"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-group">
      <view class="input-row">
        <input
          class="input-field"
          type="text"
          placeholder="请输入验证码"
          maxlength="6"
          value="{{smsCode}}"
          bindinput="onSmsCodeInput"
        />
        <view
          class="code-btn {{codeBtnDisabled ? 'disabled' : ''}}"
          bindtap="sendCode"
        >{{codeBtnText}}</view>
      </view>
    </view>

    <view class="input-group">
      <input
        class="input-field"
        type="password"
        placeholder="请输入密码（至少6位）"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="input-group">
      <input
        class="input-field"
        type="password"
        placeholder="请确认密码"
        value="{{confirmPassword}}"
        bindinput="onConfirmInput"
      />
    </view>

    <view class="agreement" bindtap="toggleAgree">
      <text class="checkbox {{agreeTerms ? 'checked' : ''}}">{{agreeTerms ? '✓' : ''}}</text>
      <text class="agree-text">我已阅读并同意 <text class="link">《用户协议》</text></text>
    </view>

    <button
      class="btn-primary"
      bindtap="submitRegister"
      disabled="{{submitting}}"
    >注册</button>

    <view class="login-link">
      <text>已有账号？</text>
      <text class="link" bindtap="goLogin">立即登录</text>
    </view>
  </view>
</view>
