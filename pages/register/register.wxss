/* 注册页 */
.register-container {
  min-height: 100vh;
  background: #ffffff;
  padding: 60rpx 50rpx 40rpx;
}

.register-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.register-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.register-subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.register-form .input-group {
  margin-bottom: 28rpx;
}

/* 协议复选框 */
.agreement-checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
  line-height: 1.6;
  flex-wrap: wrap;
}

.agreement-checkbox checkbox {
  transform: scale(0.7);
  margin-right: 4rpx;
}

.agreement-checkbox .agree-label {
  margin-right: 4rpx;
}

.agreement-checkbox .link {
  color: #7c93ff;
  display: inline;
}



.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 26rpx;
  color: #999;
}

.login-link .link {
  margin-left: 4rpx;
}
