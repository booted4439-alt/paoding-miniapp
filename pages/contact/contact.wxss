/* 联系页 */
.contact-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.contact-header {
  padding: 50rpx 30rpx 20rpx;
  text-align: center;
}

.contact-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.contact-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 10rpx;
}

.contact-list {
  padding: 0;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  font-size: 40rpx;
  width: 56rpx;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.contact-action {
  font-size: 26rpx;
  color: #7c93ff;
  padding: 8rpx 20rpx;
  border: 2rpx solid #7c93ff;
  border-radius: 8rpx;
}

.work-hours-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.work-hours-text {
  font-size: 26rpx;
  color: #666;
}

.qr-image {
  width: 300rpx;
  height: 300rpx;
  display: block;
  margin: 20rpx auto;
}

.qr-hint {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  display: block;
}
