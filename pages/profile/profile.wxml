<!-- 个人中心 -->
<view class="profile-page">

  <!-- 风景背景头部 -->
  <view class="profile-header" style="{{bgStyle}}">
    <!-- 底部渐变遮罩（让风景平滑过渡到内容） -->
    <view class="header-mask"></view>

    <!-- 未登录 -->
    <view class="header-content" wx:if="{{!isLoggedIn}}">
      <view class="avatar-placeholder">
        <text class="avatar-text">未登录</text>
      </view>
      <button class="login-btn" style="width: 50%;" bindtap="goLogin">点击登录 / 注册</button>
    </view>

    <!-- 已登录 -->
    <view class="header-content" wx:else>
      <view class="avatar">
        <image class="avatar-img" src="/images/avatar.png"></image>
      </view>
      <text class="user-name">{{userInfo.username || '用户'}}</text>
      <text class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</text>
      <text class="user-phone" wx:else>执业律师 · 民商事诉讼</text>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats-card card" wx:if="{{isLoggedIn}}">
    <view class="stat-item">
      <text class="stat-number">{{stats.consultations}}</text>
      <text class="stat-label">总咨询</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-number">{{stats.active}}</text>
      <text class="stat-label">进行中</text>
    </view>
  </view>

  <!-- 主题切换 -->
  <view class="theme-section">
    <view class="theme-section-header" bindtap="toggleThemePicker">
      <text class="theme-section-icon">🎨</text>
      <text class="theme-section-text">风景背景</text>
      <text class="theme-current">{{currentThemeName}}</text>
      <text class="theme-arrow {{themePickerOpen ? 'arrow-up' : ''}}">▾</text>
    </view>
    <view class="theme-grid {{themePickerOpen ? 'theme-grid-open' : ''}}">
      <view class="theme-item {{currentTheme === item.key ? 'theme-item-active' : ''}}"
            wx:for="{{themeList}}" wx:key="key"
            data-theme="{{item.key}}"
            bindtap="selectTheme">
        <view class="theme-dot" style="background:{{item.color}}"></view>
        <text class="theme-name">{{item.name}}</text>
        <view class="theme-check" wx:if="{{currentTheme === item.key}}">✓</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card card">
    <view class="menu-item" bindtap="goConsultations" wx:if="{{isLoggedIn}}">
      <text class="menu-icon">💬</text>
      <text class="menu-text">我的咨询</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goContact">
      <text class="menu-icon">📍</text>
      <text class="menu-text">联系我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isLoggedIn}}" bindtap="logout">
      <text class="menu-icon">🚪</text>
      <text class="menu-text" style="color:#ee0a24;">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
