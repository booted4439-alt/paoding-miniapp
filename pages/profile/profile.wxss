/* 个人中心 */
.profile-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f8f9fb;
}

/* ========== 风景背景头部 ========== */
.profile-header {
  position: relative;
  width: 100%;
  height: 420rpx;
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  overflow: hidden;
}

/* 底部渐变遮罩 */
.header-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(255,255,255,0.97) 0%, transparent 100%);
  pointer-events: none;
  z-index: 1;
}

/* 头部内容容器 */
.header-content {
  position: absolute;
  bottom: 70rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  padding: 0 40rpx;
}

/* 头像 */
.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border: 4rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.15);
}

.avatar-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 16rpx;
  border: 4rpx solid rgba(255,255,255,0.85);
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.15);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.login-btn {
  padding: 18rpx 60rpx;
  background: rgba(255,255,255,0.95);
  color: #4d6bfe;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.login-btn::after {
  border: none;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25);
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-top: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* ========== 统计卡片 ========== */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 30rpx;
  margin: -60rpx 24rpx 0;
  position: relative;
  z-index: 3;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-number {
  font-size: 42rpx;
  font-weight: 700;
  color: #4d6bfe;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: #e5e5e5;
}

/* ========== 主题选择器 ========== */
.theme-section {
  margin: 20rpx 24rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.theme-section-header {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
  cursor: pointer;
}

.theme-section-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.theme-section-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.theme-current {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.theme-arrow {
  font-size: 28rpx;
  color: #ccc;
  transition: transform 0.3s;
}

.arrow-up {
  transform: rotate(180deg);
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx 0;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, padding 0.35s ease;
}

.theme-grid-open {
  max-height: 600rpx;
  padding: 0 20rpx 24rpx;
}

.theme-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  position: relative;
  cursor: pointer;
}

.theme-item-active .theme-dot {
  outline: 4rpx solid #4d6bfe;
  outline-offset: 4rpx;
}

.theme-dot {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.theme-name {
  font-size: 22rpx;
  color: #666;
}

.theme-check {
  position: absolute;
  top: 6rpx;
  right: 50%;
  margin-right: -28rpx;
  width: 28rpx;
  height: 28rpx;
  background: #4d6bfe;
  border-radius: 50%;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

/* ========== 菜单卡片 ========== */
.menu-card {
  margin: 20rpx 24rpx;
  padding: 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  width: 52rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}
