/* 咨询详情 - 聊天 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 头部 */
.chat-header {
  background: #ffffff;
  padding: 20rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
  flex-shrink: 0;
}

.chat-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.chat-header-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.action-btn {
  font-size: 24rpx;
  color: #7c93ff;
  padding: 4rpx 16rpx;
  border: 2rpx solid #7c93ff;
  border-radius: 8rpx;
}

.action-btn.danger {
  color: #ee0a24;
  border-color: #ee0a24;
}

/* 消息列表 */
.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 30rpx;
  background: #f5f7fa;
}

.msg-item {
  display: flex;
  margin-bottom: 24rpx;
  justify-content: flex-start;
}

.msg-item.other {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 70%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.04);
}

.msg-item:not(.other) .msg-bubble {
  background: #4d6bfe;
  color: #ffffff;
}

.msg-sender {
  font-size: 22rpx;
  color: #7c93ff;
  display: block;
  margin-bottom: 6rpx;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

.msg-image {
  max-width: 300rpx;
  max-height: 300rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.msg-file {
  margin-top: 8rpx;
  font-size: 24rpx;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.msg-time {
  font-size: 20rpx;
  color: #bbb;
  display: block;
  margin-top: 8rpx;
}

.msg-item:not(.other) .msg-time {
  color: rgba(255,255,255,0.6);
}

/* 输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-top: 2rpx solid #f0f0f0;
  flex-shrink: 0;
}

.input-tools {
  display: flex;
  gap: 10rpx;
  margin-right: 12rpx;
}

.tool-btn {
  font-size: 40rpx;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 24rpx;
  background: #4d6bfe;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  border: none;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  line-height: 1;
}

.send-btn::after {
  border: none;
}

.loading-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}
