<!-- 咨询详情 - 聊天 -->
<view class="chat-page">
  <!-- 顶部信息 -->
  <view class="chat-header">
    <view class="chat-header-top">
      <text wx:if="{{consultation}}" class="chat-title">{{consultation.title}}</text>
      <text wx:if="{{consultation}}" class="status-tag status-{{consultation.status}}">{{statusText}}</text>
    </view>
  </view>
  <view wx:if="{{showFeeInfo}}" class="fee-info">
    <text>已扣费 <text style="color:#e44;font-weight:700;">{{feeAmount}}</text> 元，律师回复 {{replyCount}} 次，剔除 {{excludedCount}} 次，最终按照 {{payableCount}} 次扣费</text>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view wx:if="{{!loading}}" class="msg-list" scroll-y scroll-with-animation scroll-into-view="msg-end">
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-item {{item.isMine ? 'self' : 'other'}}">
        <view class="msg-bubble">
          <text wx:if="{{!item.is_system}}" class="msg-sender">{{item.isMine ? '我' : item.sender}}</text>
          <text wx:if="{{item.content}}" class="msg-text">{{item.content}}</text>
          <image wx:if="{{item.isImage}}" class="msg-image" src="{{item.fileUrl}}" mode="aspectFit" data-url="{{item.file_url}}" data-type="{{item.file_type}}" bindtap="previewFile" />
          <view wx:elif="{{item.file_url}}" class="msg-file" data-url="{{item.file_url}}" data-type="{{item.file_type}}" bindtap="previewFile">
            <text>📎 附件 ({{item.file_type || '未知'}})</text>
          </view>
          <text class="msg-time">{{item.created_at}}</text>
        </view>
      </view>
    </block>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 输入区 -->
  <view wx:if="{{!consultation || consultation.status !== 'closed'}}" class="input-bar safe-bottom">
    <textarea class="chat-input" placeholder="输入消息..." value="{{inputContent}}" bindinput="onInput" auto-height maxlength="6000" confirm-type="send" bindconfirm="sendMessage" />
    <view class="input-tools">
      <text class="tool-btn" bindtap="chooseImage">📷</text>
      <text class="tool-btn" bindtap="chooseFile">📎</text><!-- 从微信聊天选文件 -->
      <text class="send-btn" bindtap="sendMessage">➤</text>
    </view>
  </view>
</view>
