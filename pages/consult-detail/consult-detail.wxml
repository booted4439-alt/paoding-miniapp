<!-- 咨询详情 - 聊天 -->
<view class="chat-page">
  <!-- 顶部信息 -->
  <view class="chat-header">
    <view class="chat-header-top">
      <text wx:if="{{consultation}}" class="chat-title">{{consultation.title}}</text>
      <text wx:if="{{consultation}}" class="status-tag status-{{consultation.status}}">{{getStatusText(consultation.status)}}</text>
    </view>
    <view wx:if="{{consultation && consultation.status !== 'closed'}}" class="chat-header-actions">
      <text class="action-btn" bindtap="closeConsultation">关闭咨询</text>
      <text class="action-btn danger" bindtap="deleteConsultation">删除</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view wx:if="{{!loading}}" class="msg-list" scroll-y scroll-with-animation scroll-into-view="msg-end">
    <block wx:for="{{messages}}" wx:key="id">
      <view class="msg-item {{item.isMine ? '' : 'other'}}">
        <view class="msg-bubble">
          <text wx:if="{{!item.isMine && !item.is_system}}" class="msg-sender">{{item.sender}}</text>
          <text wx:if="{{item.content}}" class="msg-text">{{item.content}}</text>
          <image wx:if="{{item.isImage}}" class="msg-image" src="{{item.fileUrl}}" mode="aspectFit" data-url="{{item.file_url}}" bindtap="previewFile" />
          <view wx:elif="{{item.file_url}}" class="msg-file">
            <text>📎 附件</text>
          </view>
          <text class="msg-time">{{item.created_at}}</text>
        </view>
      </view>
    </block>
    <view id="msg-end"></view>
  </scroll-view>

  <!-- 输入区 -->
  <view wx:if="{{!consultation || consultation.status !== 'closed'}}" class="input-bar safe-bottom">
    <textarea class="chat-input" placeholder="输入消息..." value="{{inputContent}}" bindinput="onInput" auto-height maxlength="6000" confirm-type="send" bindconfirm="sendMessage" />
    <view class="input-tools">
      <text class="tool-btn" bindtap="chooseImage">📷</text>
      <text class="tool-btn" bindtap="chooseFile">📎</text>
      <text class="send-btn" bindtap="sendMessage">➤</text>
    </view>
  </view>
</view>
