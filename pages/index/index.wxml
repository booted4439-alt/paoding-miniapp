<!-- 首页 -->
<view class="page-container">
  <!-- Banner -->
  <view class="banner">
    <text class="banner-title">{{siteName}}</text>
    <image class="banner-logo" src="https://calculuslaw.com/static/logo-white.svg" mode="widthFix"></image>
    <text class="banner-subtitle">AI+律师审核</text>
    <text class="banner-tip">提供法律服务，用户提出咨询后，6小时内由专业律师回复。</text>
    <view class="banner-actions">
      <button class="banner-btn" bindtap="goConsult">立即咨询</button>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions card">
    <view class="quick-row" bindtap="goConsult">
      <text class="quick-icon">💬</text>
      <view class="quick-info">
        <text class="quick-title">法律咨询</text>
        <text class="quick-desc">全部咨询由专业律师回复</text>
      </view>
      <text class="quick-arrow">›</text>
    </view>
    <view class="quick-row" bindtap="goContact">
      <text class="quick-icon">📍</text>
      <view class="quick-info">
        <text class="quick-title">联系我们</text>
        <text class="quick-desc">{{sitePhone}} · {{siteAddress}}</text>
      </view>
      <text class="quick-arrow">›</text>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="login-prompt" wx:if="{{!isLoggedIn}}">
    <text class="login-prompt-text">登录后可发起法律咨询</text>
    <button class="login-prompt-btn" bindtap="goLogin">登录 / 注册</button>
  </view>
  
  <!-- 工作时间 -->
  <view class="work-hours-bar">
    <text class="work-hours-icon">🕐</text>
    <text class="work-hours-text">律师工作时间：周一至周日 6:00 - 22:00</text>
  </view>
</view>
