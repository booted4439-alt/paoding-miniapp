/* 首页样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #4d6bfe, #7c93ff);
  padding: 160rpx 40rpx 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
}

.banner-title {
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.banner-subtitle {
  font-size: 38rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.banner-tip {
  font-size: 30rpx;
  color: #e8b830;
  margin-bottom: 40rpx;
  text-align: center;
  padding: 0 30rpx;
  line-height: 1.5;
}

.banner-actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.banner-btn {
  width: 400rpx;
  height: 88rpx;
  background: #ffffff;
  color: #4d6bfe;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.banner-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 快捷入口 */
.quick-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.quick-row:last-child {
  border-bottom: none;
}

.quick-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
  margin-right: 24rpx;
}

.quick-info {
  flex: 1;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.quick-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 登录提示 */
.login-prompt {
  margin: 30rpx;
  padding: 40rpx;
  background: #e8f0f8;
  border-radius: 16rpx;
  text-align: center;
}

.login-prompt-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.login-prompt-btn {
  display: inline-block;
  padding: 16rpx 60rpx;
  background: #4d6bfe;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
