/* 首页样式 */
.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* Banner */
.banner {
  position: relative;
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  padding: 120rpx 40rpx 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

/* 深色渐变遮罩，确保任何背景下文字都清晰 */
.banner-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.45) 100%);
  pointer-events: none;
  z-index: 0;
}

.banner-slogan {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  margin-bottom: 50rpx;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.banner-title-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 1;
}

.banner-logo {
  width: 200rpx;
  height: auto;
  margin-right: 16rpx;
}

.banner-title {
  font-size: 50rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #f5e6d0, #e8d5b7 50%, #d4b896);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow: 0 2rpx 20rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  font-size: 38rpx;
  color: rgba(255,255,255,0.95);
  margin-bottom: 70rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25);
}

.banner-tip {
  font-size: 30rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 40rpx;
  text-align: center;
  padding: 0 30rpx;
  line-height: 1.5;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2);
}

.banner-actions {
  width: 100%;
  display: flex;
  justify-content: center;
}

.banner-btn {
  width: 400rpx;
  height: 88rpx;
  background: #ffffff;
  color: #4d6bfe;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.banner-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 快捷入口 */
.quick-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.quick-row:last-child {
  border-bottom: none;
}

.quick-icon {
  font-size: 44rpx;
  width: 64rpx;
  text-align: center;
  margin-right: 24rpx;
}

.quick-info {
  flex: 1;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.quick-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* 登录提示 */
.login-prompt {
  margin: 30rpx;
  padding: 40rpx;
  background: #e8f0f8;
  border-radius: 16rpx;
  text-align: center;
}

.login-prompt-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.login-prompt-btn {
  display: inline-block;
  padding: 16rpx 60rpx;
  background: #4d6bfe;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 工作时间 */
.work-hours-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 30rpx 40rpx;
  gap: 10rpx;
}

.work-hours-icon {
  font-size: 28rpx;
}

.work-hours-text {
  font-size: 24rpx;
  color: #999;
}
