<!-- 文档详情 -->
<view class="doc-detail-page">
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <!-- 文档头部 -->
    <view class="doc-detail-header card">
      <text class="doc-detail-title">{{document.title}}</text>
      <view class="doc-detail-meta">
        <text class="doc-category" wx:if="{{document.category}}">{{document.category}}</text>
        <text class="doc-date">{{document.updated_at}}</text>
      </view>
    </view>

    <!-- 文档内容（HTML 渲染） -->
    <view class="doc-detail-content card">
      <rich-text nodes="{{renderedHtml}}" class="doc-rendered"></rich-text>
    </view>

    <!-- 底部操作 -->
    <view class="doc-detail-footer">
      <button class="btn-secondary" style="width:auto;padding:0 40rpx;" bindtap="copyLink">复制链接</button>
    </view>
  </view>
</view>
