/* 文档列表 */
.doc-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 搜索 */
.search-bar {
  padding: 20rpx 30rpx;
  background: #ffffff;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 0 24rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
}

.search-icon {
  font-size: 32rpx;
  padding: 8rpx;
}

/* 分类标签 */
.category-scroll {
  white-space: nowrap;
  padding: 16rpx 30rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}

.category-tab {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f7fa;
  border-radius: 30rpx;
}

.category-tab.active {
  color: #fff;
  background: #4d6bfe;
}

/* 文档列表 */
.doc-list {
  padding: 20rpx 30rpx;
}

.doc-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.doc-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
  line-height: 1.5;
}

.doc-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.doc-category {
  font-size: 24rpx;
  color: #7c93ff;
  background: #e8f0f8;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.doc-date {
  font-size: 24rpx;
  color: #bbb;
}

.doc-summary {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
