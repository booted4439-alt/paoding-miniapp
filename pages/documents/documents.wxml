<!-- 法律文档列表 -->
<view class="doc-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <input
        class="search-input"
        type="text"
        placeholder="搜索法律法规..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="search"
      />
      <text class="search-icon" bindtap="search">🔍</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x wx:if="{{categories.length > 0}}">
    <view
      class="category-tab {{activeCategory === '' ? 'active' : ''}}"
      data-category=""
      bindtap="filterByCategory"
    >全部</view>
    <view
      class="category-tab {{activeCategory === cat ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="this"
      data-category="{{item}}"
      bindtap="filterByCategory"
    >{{item}}</view>
  </scroll-view>

  <!-- 文档列表 -->
  <view class="doc-list">
    <view class="empty-state" wx:if="{{documents.length === 0 && !loading}}">
      <text>暂无文档</text>
    </view>

    <view
      class="doc-item"
      wx:for="{{documents}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <text class="doc-title">{{item.title}}</text>
      <view class="doc-meta">
        <text class="doc-category">{{item.category}}</text>
        <text class="doc-date">{{item.updated_at}}</text>
      </view>
      <text class="doc-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
    </view>
  </view>
</view>
